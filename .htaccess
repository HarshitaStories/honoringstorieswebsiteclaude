# Honoring Stories: server configuration for Hostinger.
#
# The site is deployed straight from this Git repository into public_html, so
# everything in the repo lands on the live server. The repo holds project files
# as well as the website itself, and the rules below make sure only the website
# is reachable from the web.

DirectoryIndex index.html

# ---------------------------------------------------------------------------
# Block the project files that are not part of the website
# ---------------------------------------------------------------------------
# WEBSITE_INSTRUCTIONS.md, the Word exports, the packaged zips and the local
# server script. None contain passwords, but they are internal working
# documents and have no business being downloadable from the live domain.
<FilesMatch "\.(md|docx|zip|ps1)$">
  Require all denied
</FilesMatch>

# Scratch pages built to prototype the submit-then-moderate flow, plus an old
# throwaway file. They are marked as test pages and are not part of the site.
<FilesMatch "^(userresponse|usersubmission|hello)\.html$">
  Require all denied
</FilesMatch>

# lib.php only defines functions and is included by the other three scripts.
# Loading it directly does nothing, but there is no reason for it to be a URL.
<Files "lib.php">
  Require all denied
</Files>

# Dotfiles: .gitignore, .gitattributes and anything similar.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# The Sveltia CMS folder. It was started and never finished, and has since been
# superseded by admin.php, which does the same job with a password checked on
# the server. Blocked so a visitor cannot find a half built admin screen.
#
# The pattern is anchored to the FOLDER. Written unanchored as "/admin" it also
# matches "/admin.php", which would 404 the real moderation page.
RedirectMatch 404 ^/admin/

# The store for the coping notes. It holds submissions that have not been
# approved and the admin password hash. data/.htaccess denies the folder as
# well; this is the same rule stated at the root, so the folder stays shut even
# if that file is lost during an upload.
RedirectMatch 404 ^/data/

# A .git directory inside the web root would expose the entire repository
# history to anyone who guessed the path. Deploy tools sometimes leave one.
RedirectMatch 404 /\.git

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Images are the heavy part of this site and change rarely, so let browsers
  # hold on to them. If one is replaced, its filename usually changes too.
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # HTML must not be cached. Every page carries its own CSS and JavaScript
  # inline, so a stale HTML file is a stale website, not just stale text.
  ExpiresByType text/html "access plus 0 seconds"

  # notes.json is the published coping notes. Caching it would mean a newly
  # approved note not appearing until the visitor's cache expired.
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
# The pages run 38 to 79 KB each because the styling is inline, so this makes a
# real difference on a slow connection.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
